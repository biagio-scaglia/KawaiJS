# Kawaijs Showcase Visual Novel — "Code of Hearts"
character yumia "Yumia" #f43f5e
character kaori "Kaori" #0284c7

label start:
    set player_name = "Sensei"
    set dev_score = 0
    set creative_score = 0

    play music bgm_ambient fade 2

    scene bg classroom with fade
    vfx sakura
    show yumia happy at left with bounce
    show kaori normal at right with dissolve

    yumia "Welcome to the {b}Game Development Club{/b}, [player_name]! I'm Yumia, the lead writer and designer."
    kaori "And I'm Kaori. I oversee the {color=#38bdf8}engine architecture{/color} and Web Audio pipeline."

    yumia "We're building our next visual novel using {b}Kawaijs{/b} — a modern, web-native scripting engine."
    kaori "It compiles human-friendly .kawa scripts directly into deterministic bytecode that runs smoothly in any browser."

    play sound sfx_sparkle
    camera flash
    yumia "We need your help to choose our project's main direction, [player_name]! What is your biggest strength?"

    menu:
        "High-performance architecture & Web Audio":
            play sound sfx_click
            camera vpunch
            set dev_score += 2
            show kaori happy at right with nod
            show yumia normal at left
            kaori "Impressive. An engineer with an eye for modularity and crisp performance."
            yumia "Hey! Don't forget that great stories need emotional resonance too!"
            jump technical_route

        "Rich storytelling, character drama & art":
            play sound sfx_click
            camera shake 500
            set creative_score += 2
            show yumia excited at left with bounce
            show kaori thinking at right
            yumia "Yes!! That's the spirit! Players remember characters that touch their hearts."
            kaori "A solid script is essential, provided the memory footprint stays lightweight."
            jump creative_route

        "Full-stack mastery: Code, Music, and Narrative":
            play sound sfx_click
            camera flash
            set dev_score += 1
            set creative_score += 1
            show yumia excited at left with bounce
            show kaori smug at right with nod
            kaori "Ambitious. A true solo-dev Renaissance creator."
            yumia "That means we can make something truly unforgettable together, [player_name]!"
            jump courtyard_scene

label technical_route:
    play music bgm_upbeat fade 1
    scene bg rooftop with fade
    vfx fog
    show kaori smug at center with dissolve

    kaori "Up here on the misty rooftop, the architecture comes together cleanly."
    kaori "With Kawaijs, we get rollback snapshots in O(1) time and instant HMR via the Vite plugin."
    
    play sound sfx_sparkle
    camera flash
    pause 600
    cg "cg_sunset_promise.svg" as "sunset_promise"
    kaori "Look at the horizon, [player_name]. With a technical score of [dev_score], every browser tab becomes a stage for interactive fiction."
    jump evaluate_ending

label creative_route:
    play music bgm_upbeat fade 1
    scene bg sunset_courtyard with fade
    vfx sakura
    vfx tint "#fda4af"
    show yumia happy at center with bounce

    yumia "Isn't the sunset courtyard breathtaking, [player_name]?"
    yumia "With Kawaijs, writers don't need complex code to craft branching paths or dialogue menus."
    
    play sound sfx_sparkle
    camera flash
    pause 600
    cg "cg_sunset_promise.svg" as "sunset_promise"
    yumia "With a creative score of [creative_score], the cherry blossoms remind me that great stories bloom when imagination meets great tools."
    jump evaluate_ending

label courtyard_scene:
    play music bgm_upbeat fade 1
    scene bg sunset_courtyard with fade
    vfx sakura
    show yumia happy at left with bounce
    show kaori happy at right with nod

    yumia "Look at the sunset! We've already outlined our story branches and characters."
    kaori "The bundle compiled in under 15ms. The Web Audio controller is initialized and ready."
    
    camera hpunch
    yumia "Let's bring all our talents together!"
    jump evaluate_ending

label evaluate_ending:
    if dev_score >= 2:
        jump ending_tech
    else:
        if creative_score >= 2:
            jump ending_creative
        else:
            jump ending_master

label ending_tech:
    scene bg rooftop with fade
    vfx fog
    show kaori smug at center
    kaori "You have proven your engineering mastery with [dev_score] dev points. Our next release will be revolutionary."
    narrator "{b}Ending 1/3: The Master Architect{/b} — High Performance & Flawless Code."
    stop music fade 2
    return

label ending_creative:
    scene bg sunset_courtyard with fade
    vfx sakura
    show yumia excited at center with bounce
    yumia "Our visual novel scored [creative_score] in creativity! It's going to touch millions of hearts around the world!"
    narrator "{b}Ending 2/3: The Renowned Storyteller{/b} — Emotion, Art & Unforgettable Characters."
    stop music fade 2
    return

label ending_master:
    play sound sfx_sparkle
    camera flash
    pause 800
    cg "cg_celebration.svg" as "celebration"
    yumia "Code, art, music, and story in perfect harmony! Dev: [dev_score], Creative: [creative_score]!"
    kaori "You have unlocked the full power of Kawaijs, [player_name]."
    narrator "{b}Ending 3/3: The Renaissance Visionary{/b} — A True Master of Interactive Fiction."
    stop music fade 2
    return
