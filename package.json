{
  "name": "kawaijs-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A web-native visual novel engine and toolchain inspired by Ren'Py",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./packages/cli/bin/kawa.js dev ./examples/hello-world",
    "dev:docs": "node ./packages/cli/bin/kawa.js dev ./examples/docs",
    "dev:showcase": "node ./packages/cli/bin/kawa.js dev ./examples/showcase",
    "build": "tsc -b",
    "build:example": "node ./packages/cli/bin/kawa.js build ./examples/hello-world",
    "build:docs": "node ./packages/cli/bin/kawa.js build ./examples/docs",
    "build:showcase": "node ./packages/cli/bin/kawa.js build ./examples/showcase",
    "build:playground": "node ./scripts/build-playground.js",
    "assemble:pages": "node ./scripts/assemble-pages.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js patch",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "keywords": [
    "visual-novel",
    "renpy",
    "game-engine",
    "web-native",
    "typescript"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@types/node": "^26.5.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
