{
  "name": "kawaijs-monorepo",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "A web-native visual novel engine and toolchain inspired by Ren'Py",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./packages/cli/bin/kawa.js dev ./examples/hello-world",
    "build": "tsc -b",
    "build:example": "node ./packages/cli/bin/kawa.js build ./examples/hello-world",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js patch",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "keywords": [
    "visual-novel",
    "renpy",
    "game-engine",
    "web-native",
    "typescript"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
